    "create_statement": "CREATE TABLE `exercises` (\n  `Id` int(11) NOT NULL AUTO_INCREMENT,\n  `Subject` varchar(60) DEFAULT NULL,\n  `Level` varchar(10) DEFAULT NULL,\n  `Title` varchar(250) DEFAULT NULL,\n  `Content` longtext DEFAULT NULL,\n  `structure_type` enum('simple','multi-parties') DEFAULT 'simple',\n  `pattern_detected` varchar(20) DEFAULT NULL,\n  `sub_questions` longtext CHARACTER SET utf8mb4 COLLATE utf8mb4_bin DEFAULT NULL COMMENT 'Sous-questions parsees automatiquement' CHECK (json_valid(`sub_questions`)),\n  `Type` varchar(32) DEFAULT NULL,\n  `Answer` longtext DEFAULT NULL,\n  `InteractiveConfig` longtext CHARACTER SET utf8mb4 COLLATE utf8mb4_bin DEFAULT NULL CHECK (json_valid(`InteractiveConfig`)),\n  `Tips` longtext DEFAULT NULL COMMENT 'Astuces pédagogiques et gamification',\n  `Domain` varchar(150) DEFAULT NULL COMMENT 'Domaine pédagogique (ex: Grammaire, Algèbre)',\n  `Competence` varchar(200) DEFAULT NULL COMMENT 'Compétence ciblée',\n  `Difficulty` varchar(10) DEFAULT NULL COMMENT 'Niveau de difficulté (facile, moyen, difficile)',\n  `exam_prep` varchar(20) DEFAULT NULL COMMENT 'BAC, BREVET, ou NULL',\n  `Identifier` varchar(50) DEFAULT NULL COMMENT 'Code unique (ex: FR-6EME-001)',\n  `AnswerType` varchar(30) DEFAULT NULL COMMENT 'Type de réponse attendue (qcm, texte, calcul, appariement, etc.)',\n  `Choices` longtext CHARACTER SET utf8mb4 COLLATE utf8mb4_bin DEFAULT NULL COMMENT 'Liste des choix pour QCM ou appariement' CHECK (json_valid(`Choices`)),\n  `Instruction` text DEFAULT NULL COMMENT 'Consigne spécifique à l’élève (si différente de Content)',\n  `is_active` tinyint(1) DEFAULT 1,\n  `XP_Points` int(11) DEFAULT 10,\n  `Coherence` tinyint(1) DEFAULT 0 COMMENT 'Indique si l''exercice est cohérent avec le parcours',\n  `processed` tinyint(1) DEFAULT 0,\n  `course_id` int(11) DEFAULT NULL,\n  `LinkedCourses` text DEFAULT NULL COMMENT 'JSON array des IDs de cours liés (ex: [1, 2, 3])',\n  `created_at` datetime DEFAULT current_timestamp() COMMENT 'Date de création de l''exercice',\n  `updated_at` datetime DEFAULT current_timestamp() ON UPDATE current_timestamp() COMMENT 'Date de dernière modification',\n  PRIMARY KEY (`Id`),\n  KEY `idx_identifier` (`Identifier`),\n  KEY `idx_level_subject` (`Level`,`Subject`),\n  KEY `idx_course_id` (`course_id`),\n  KEY `idx_structure_type` (`structure_type`),\n  KEY `idx_exam_prep` (`exam_prep`),\n  KEY `idx_updated_at` (`updated_at`),\n  CONSTRAINT `exercises_ibfk_1` FOREIGN KEY (`course_id`) REFERENCES `course_key_points` (`id`) ON DELETE SET NULL\n) ENGINE=InnoDB AUTO_INCREMENT=1234 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci"
}