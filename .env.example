# ============================================
# MONCOACHSCOLAIRE — Configuration Example
# ============================================
#

# ============================================

# ─────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────
APP_ENV=local
APP_DEBUG=true
DEBUG_SECRET=your_debug_secret_here
BASE_URL=/moncoachscolaire
DB_READ_ONLY=false

# ─────────────────────────────────────────
# DATABASE (Local only — production uses Hostinger)
# ─────────────────────────────────────────
DB_HOST=127.0.0.1
DB_DATABASE=moncoachscolaire
DB_USERNAME=root
DB_PASSWORD=

# ─────────────────────────────────────────
# MAIL (SMTP — Hostinger)
# ─────────────────────────────────────────
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=support@moncoachscolaire.fr
MAIL_PASSWORD=your_mail_password_here
MAIL_FROM=support@moncoachscolaire.fr
MAIL_FROM_NAME=MonCoachScolaire

# ─────────────────────────────────────────
# AI PROVIDERS (Groq, OpenAI, Gemini, etc.)
# ─────────────────────────────────────────
# Groq: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Perplexity: https://www.perplexity.ai/
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# Ollama (local alternative, if self-hosting)
OLLAMA_API_URL=http://localhost:11434
