  "quiz": {
    "title": "Croissances comparées",
    "question_count": 8,
    "level": "Terminale",
    "subject": "Mathématiques",
    "answers": [
      {
        "index": 0,
        "question_id": 1,
        "type": "qcm",
        "answer": "C",
        "correction": "Hiérarchie : ln(x) ≪ xⁿ ≪ eˣ quand x→+∞. L'exponentielle croît plus vite que tout polynôme."
      },
      {
        "index": 1,
        "question_id": 2,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "L'exponentielle croît plus vite que tout polynôme : xⁿ/eˣ → 0."
      },
      {
        "index": 2,
        "question_id": 3,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "x³·e^(−x) = x³/eˣ → 0 par croissances comparées (eˣ domine x³)."
      },
      {
        "index": 3,
        "question_id": 4,
        "type": "qcm",
        "answer": "C",
        "correction": "ln(x) ≪ x : ln(x)/x → 0. Le polynôme x domine ln(x)."
      },
      {
        "index": 4,
        "question_id": 5,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "Forme 0·(−∞) : on pose t=−ln(x)→+∞, x = e^(−t). x·ln(x) = −t·e^(−t) → 0."
      },
      {
        "index": 5,
        "question_id": 6,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "La hiérarchie est : logarithme ≪ polynômes (croissant en degré) ≪ exponentielle."
      },
      {
        "index": 6,
        "question_id": 7,
        "type": "qcm",
        "answer": "B",
        "correction": "eˣ domine x² : eˣ − x² ~ eˣ → +∞."
      },
      {
        "index": 7,
        "question_id": 8,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "√x = x^(1/2) domine ln(x) : ln(x)/x^(1/2) → 0 par croissances comparées."
      }
    ]
  }
