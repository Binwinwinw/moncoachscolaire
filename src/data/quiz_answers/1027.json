  "quiz": {
    "title": "Équations & inéquations avec ln",
    "question_count": 8,
    "level": "Terminale",
    "subject": "Mathématiques",
    "answers": [
      {
        "index": 0,
        "question_id": 1,
        "type": "qcm",
        "answer": "B",
        "correction": "ln(2x−1) = 0 ⟺ 2x−1 = e⁰ = 1 ⟺ x = 1. Vérif : 2(1)−1 = 1 > 0 ✓."
      },
      {
        "index": 1,
        "question_id": 2,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "ln strictement croissante : ln(x) > 1 = ln(e) ⟺ x > e."
      },
      {
        "index": 2,
        "question_id": 3,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "ln(...)=0 ⟺ x²−3x+2 = 1 ⟺ x²−3x+1 = 0. Δ=5, x=(3±√5)/2 ≈ 0.38 et 2.62. NB: correction — x²−3x+2=1 → x²−3x+1=0, solutions (3±√5)/2."
      },
      {
        "index": 3,
        "question_id": 4,
        "type": "qcm",
        "answer": "A",
        "correction": "ln croissante : ln(x+1) ≤ ln(3) ⟺ x+1 ≤ 3 ⟺ x ≤ 2. Domaine : x+1>0 → x>−1."
      },
      {
        "index": 4,
        "question_id": 5,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "ln est défini pour des valeurs > 0, et ln(u) = k ⟺ u = eᵏ."
      },
      {
        "index": 5,
        "question_id": 6,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "ln(x(x+2)) = ln(8) ⟺ x²+2x = 8 ⟺ x²+2x−8=0 ⟺ (x+4)(x−2)=0. x=2 (x>0 exclu −4)."
      },
      {
        "index": 6,
        "question_id": 7,
        "type": "qcm",
        "answer": "B",
        "correction": "ln croissante : x > 2x−3 ⟺ x < 3. Domaine : x>0 ET 2x−3>0 → x>3/2. Solution : 3/2 < x < 3."
      },
      {
        "index": 7,
        "question_id": 8,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "ln(1) = 0, et ln est injective (strictement croissante) donc x=1 est la seule solution."
      }
    ]
  }
