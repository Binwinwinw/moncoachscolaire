        "answer": "",
        "correction": "M(θ) a pour coordonnées (cos θ, sin θ) : abscisse = cosinus, ordonnée = sinus."
      },
      {
        "index": 1,
        "question_id": 2,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "Identité fondamentale (théorème de Pythagore sur le cercle unité)."
      },
      {
        "index": 2,
        "question_id": 3,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "VRAI. Valeurs à connaître : cos(0)=1, cos(π/6)=√3/2, cos(π/4)=√2/2, cos(π/3)=1/2, cos(π/2)=0."
      },
      {
        "index": 3,
        "question_id": 4,
        "type": "qcm",
        "answer": "",
        "correction": "sin(π/3) = sin(60°) = √3/2."
      },
      {
        "index": 4,
        "question_id": 5,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "cos est paire : cos(−θ) = cos(θ). sin est impaire : sin(−θ) = −sin(θ)."
      },
      {
        "index": 5,
        "question_id": 6,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "VRAI. sin(π/6) = 1/2 → sin²(π/6) = 1/4. cos(π/4) = √2/2 → cos²(π/4) = 1/2. Somme = 3/4."
      },
      {
        "index": 6,
        "question_id": 7,
        "type": "qcm",
        "answer": "",
        "correction": "cos(π) = cos(180°) = −1. Sur le cercle unité, le point correspondant est (−1, 0)."
      },
      {
        "index": 7,
        "question_id": 8,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "Le sinus est 2π-périodique : ajouter 2π revient à faire un tour complet sur le cercle."
      }
    ]
  }
