        "index": 5,
        "question_id": 6,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "VRAI. Suite arithmétique : u₁=2000, r=50, u₁₂=2000+11×50=2550. S₁₂=12×(2000+2550)/2=27300."
