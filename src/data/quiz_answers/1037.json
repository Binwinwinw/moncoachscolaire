  "quiz": {
    "title": "Convergence et limites de suites",
    "question_count": 8,
    "level": "Terminale",
    "subject": "Mathématiques",
    "answers": [
      {
        "index": 0,
        "question_id": 1,
        "type": "qcm",
        "answer": "Pour tout ε > 0, il existe N tel que n > N ⟹ |uₙ − L| < ε",
        "correction": "C'est la définition formelle (ε-N) de la convergence d'une suite vers L."
      },
      {
        "index": 1,
        "question_id": 2,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "Théorème de la limite monotone : une suite monotone bornée est convergente."
      },
      {
        "index": 2,
        "question_id": 3,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "VRAI. Diviser par n : (2 + 1/n)/(1 + 3/n) → 2/1 = 2."
      },
      {
        "index": 3,
        "question_id": 4,
        "type": "qcm",
        "answer": "Diverge",
        "correction": "(−1)ⁿ alterne entre 1 et −1 : la suite diverge (pas de limite)."
      },
      {
        "index": 4,
        "question_id": 5,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "Les opérations algébriques sont compatibles avec la limite : somme, produit, quotient (si M≠0)."
      },
      {
        "index": 5,
        "question_id": 6,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "VRAI. |sin(n)| ≤ 1 → −1/n ≤ sin(n)/n ≤ 1/n. Comme ±1/n → 0, par gendarmes : uₙ → 0."
      },
      {
        "index": 6,
        "question_id": 7,
        "type": "qcm",
        "answer": "+∞",
        "correction": "nⁿ/n! → +∞ (Stirling : n! ~ √(2πn)·(n/e)ⁿ, donc nⁿ/n! ~ eⁿ/√(2πn) → +∞)."
      },
      {
        "index": 7,
        "question_id": 8,
        "type": "vrai-faux",
        "answer": "faux",
        "correction": "Contre-exemple : (−1)ⁿ est bornée (valeurs ±1) mais diverge. Bornée + monotone → convergente."
      }
    ]
  }
}
