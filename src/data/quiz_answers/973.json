  "quiz": {
    "title": "Équations produit-nul",
    "question_count": 8,
    "level": "2nde",
    "subject": "Mathématiques",
    "answers": [
      {
        "index": 0,
        "question_id": 1,
        "type": "qcm",
        "answer": "B",
        "correction": "Un produit est nul si et seulement si l'un au moins des facteurs est nul."
      },
      {
        "index": 1,
        "question_id": 2,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "x − 2 = 0 → x = 2 ; x + 3 = 0 → x = −3."
      },
      {
        "index": 2,
        "question_id": 3,
        "type": "open",
        "answer": "x = 0 ou x = 1",
        "correction": "x² − x = x(x−1) = 0 → x = 0 ou x − 1 = 0 → x = 1."
      },
      {
        "index": 3,
        "question_id": 4,
        "type": "qcm",
        "answer": "A",
        "correction": "2x − 4 = 0 → x = 2 ; x + 1 = 0 → x = −1."
      },
      {
        "index": 4,
        "question_id": 5,
        "type": "vrai-faux",
        "answer": "faux",
        "correction": "Au contraire, on applique directement la règle du produit nul sur la forme factorisée."
      },
      {
        "index": 5,
        "question_id": 6,
        "type": "open",
        "answer": "x = 2 ou x = −2",
        "correction": "x² − 4 = (x−2)(x+2) = 0 → x = 2 ou x = −2."
      },
      {
        "index": 6,
        "question_id": 7,
        "type": "qcm",
        "answer": "B",
        "correction": "x − 1 = 0 → x = 1 (double, mais compte pour 1 valeur distincte) ; x = −2. Donc 2 valeurs distinctes."
      },
      {
        "index": 7,
        "question_id": 8,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "x³ − x = x(x²−1) = x(x−1)(x+1) = 0 → x = 0, x = 1 ou x = −1."
      }
    ]
  }
}
