  "quiz": {
    "title": "Règles de dérivation",
    "question_count": 8,
    "level": "Terminale",
    "subject": "Mathématiques",
    "answers": [
      {
        "index": 0,
        "question_id": 1,
        "type": "qcm",
        "answer": "B",
        "correction": "Règle du produit : (f·g)' = f'·g + f·g'."
      },
      {
        "index": 1,
        "question_id": 2,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "(f/g)' = (f'g − fg') / g². Valable là où g ≠ 0."
      },
      {
        "index": 2,
        "question_id": 3,
        "type": "open",
        "answer": "f'(x) = 2x·sin(x) + x²·cos(x)",
        "correction": "(x²·sin x)' = (x²)'·sin x + x²·(sin x)' = 2x·sin x + x²·cos x."
      },
      {
        "index": 3,
        "question_id": 4,
        "type": "qcm",
        "answer": "A",
        "correction": "Règle du quotient : ((x²+1)'(x−1) − (x²+1)(x−1)') / (x−1)² = (2x(x−1) − (x²+1)) / (x−1)²."
      },
      {
        "index": 4,
        "question_id": 5,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "La dérivation est linéaire : (f+g)' = f'+g' et (λf)' = λf' pour tout scalaire λ."
      },
      {
        "index": 5,
        "question_id": 6,
        "type": "open",
        "answer": "f'(x) = 5/(x+1)²",
        "correction": "f' = (2(x+1) − (2x−3)·1)/(x+1)² = (2x+2−2x+3)/(x+1)² = 5/(x+1)²."
      },
      {
        "index": 6,
        "question_id": 7,
        "type": "qcm",
        "answer": "C",
        "correction": "(x·eˣ)' = 1·eˣ + x·eˣ = eˣ(1+x) = (x+1)eˣ. Réponse B et C sont équivalentes ; la formulation C est développée."
      },
      {
        "index": 7,
        "question_id": 8,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "Règle de la chaîne appliquée à u² avec u=f(x) : (u²)' = 2u·u' = 2f(x)·f'(x)."
      }
    ]
  }
