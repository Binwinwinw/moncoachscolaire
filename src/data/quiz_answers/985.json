  "quiz": {
    "title": "Comparaison de fonctions",
    "question_count": 8,
    "level": "2nde",
    "subject": "Mathématiques",
    "answers": [
      {
        "index": 0,
        "question_id": 1,
        "type": "qcm",
        "answer": "C",
        "correction": "f(x) > g(x) ⟺ f(x) − g(x) > 0 : on étudie le signe de la différence."
      },
      {
        "index": 1,
        "question_id": 2,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "x² = x → x² − x = 0 → x(x−1) = 0 → x = 0 ou x = 1."
      },
      {
        "index": 2,
        "question_id": 3,
        "type": "open",
        "answer": "]0 ; 1[",
        "correction": "x² − x = x(x−1). Signe négatif si x > 0 et x − 1 < 0, soit 0 < x < 1."
      },
      {
        "index": 3,
        "question_id": 4,
        "type": "qcm",
        "answer": "C",
        "correction": "Pour x > 1, x > √x car (√x)² = x et √x < x (on peut vérifier : pour x=4, 4 > 2)."
      },
      {
        "index": 4,
        "question_id": 5,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "Courbe f au-dessus de g ⟺ f(x) > g(x) sur ces intervalles."
      },
      {
        "index": 5,
        "question_id": 6,
        "type": "open",
        "answer": "f > g sur ]0 ; 2[ (intersection en x=0 et x=2 non inclus dans [0;3] pour x=2), g > f sur ]2 ; 3].",
        "correction": "2x+1 − x² = −(x²−2x−1). Racines : x = 1±√2 ≈ −0.41 et 2.41. Sur [0;3], f>g sur ]0;1+√2[ et g>f sur ]1+√2;3]."
      },
      {
        "index": 6,
        "question_id": 7,
        "type": "qcm",
        "answer": "C",
        "correction": "Pour 0 < x < 1, √x > x. Ex: x = 0,25 → √x = 0,5 > 0,25."
      },
      {
        "index": 7,
        "question_id": 8,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "C'est exactement l'outil algébrique permettant la comparaison complète de deux fonctions."
      }
    ]
  }
