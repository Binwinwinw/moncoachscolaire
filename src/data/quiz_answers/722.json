  "quiz": {
    "title": "Électricité : loi d'Ohm et résistances",
    "question_count": 8,
    "level": "3ème",
    "subject": "Physique-Chimie",
    "answers": [
      {
        "index": 0,
        "question_id": 1,
        "type": "qcm",
        "answer": "U = R × I",
        "correct": 1,
        "correction": "La loi d'Ohm : U = R·I où U est la tension (V), R la résistance (Ω) et I l'intensité (A)."
      },
      {
        "index": 1,
        "question_id": 2,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "L'unité de résistance est l'ohm (Ω), défini comme 1 V/A, en l'honneur de Georg Simon Ohm."
      },
      {
        "index": 2,
        "question_id": 3,
        "type": "open",
        "answer": "30 Ω",
        "correction": "R = U/I = 12/0,4 = 30 Ω."
      },
      {
        "index": 3,
        "question_id": 4,
        "type": "qcm",
        "answer": "30 Ω",
        "correct": 2,
        "correction": "En série : R_totale = R1 + R2 = 10 + 20 = 30 Ω."
      },
      {
        "index": 4,
        "question_id": 5,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "En parallèle : 1/R_éq = 1/R1 + 1/R2, donc R_éq < min(R1, R2)."
      },
      {
        "index": 5,
        "question_id": 6,
        "type": "open",
        "answer": "0,2 A",
        "correction": "I = U/R = 10/50 = 0,2 A."
      },
      {
        "index": 6,
        "question_id": 7,
        "type": "qcm",
        "answer": "Est constante quelle que soit la tension appliquée",
        "correct": 2,
        "correction": "Un conducteur ohmique suit la loi d'Ohm : U/I = constante = R, indépendamment de la tension."
      },
      {
        "index": 7,
        "question_id": 8,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "La caractéristique U/I d'une diode n'est pas linéaire ; elle conduit le courant dans un sens seulement."
      }
    ]
  }
