        "question_id": 1,
        "type": "qcm",
        "answer": "B",
        "correction": "IPP : ∫ u'v dx = [uv] − ∫ uv' dx. On dérive v et on intègre u'."
      },
      {
        "index": 1,
        "question_id": 2,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "u' = eˣ → u = eˣ ; v = x → v' = 1. IPP : ∫ xeˣ dx = x·eˣ − ∫ eˣ dx = xeˣ − eˣ + C."
      },
      {
        "index": 2,
        "question_id": 3,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "IPP : u'=eˣ, u=eˣ ; v=x, v'=1. ∫xeˣ dx = xeˣ − ∫eˣ dx = xeˣ − eˣ + C = (x−1)eˣ + C."
      },
      {
        "index": 3,
        "question_id": 4,
        "type": "qcm",
        "answer": "B",
        "correction": "On pose u' = 1 → u = x et v = ln(x) → v' = 1/x. IPP : ∫ln(x)dx = x·ln(x) − x + C."
      },
      {
        "index": 4,
        "question_id": 5,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "Résultat par IPP : ∫ln x dx = x·ln x − ∫ x·(1/x) dx = x·ln x − x + C."
      },
      {
        "index": 5,
        "question_id": 6,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "[x·ln(x) − x]₁ᵉ = (e·1 − e) − (1·0 − 1) = 0 − (−1) = 1."
      },
      {
        "index": 6,
        "question_id": 7,
        "type": "qcm",
        "answer": "A",
        "correction": "IPP : u'=cos x → u=sin x ; v=x → v'=1. ∫x·cos x dx = x·sin x − ∫sin x dx = x·sin x + cos x + C."
