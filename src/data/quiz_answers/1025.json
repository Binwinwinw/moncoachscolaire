  "quiz": {
    "title": "Fonction logarithme népérien",
    "question_count": 8,
    "level": "Terminale",
    "subject": "Mathématiques",
    "answers": [
      {
        "index": 0,
        "question_id": 1,
        "type": "qcm",
        "answer": "]0 ; +∞[",
        "correction": "ln est défini uniquement pour x > 0, donc sur ]0 ; +∞[."
      },
      {
        "index": 1,
        "question_id": 2,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "ln(1) = 0 car e⁰ = 1. C'est une valeur fondamentale à retenir."
      },
      {
        "index": 2,
        "question_id": 3,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "VRAI. ln(x) = 3 ⟺ x = e³ (définition du logarithme comme réciproque de l'exponentielle)."
      },
      {
        "index": 3,
        "question_id": 4,
        "type": "qcm",
        "answer": "2e",
        "correction": "ln(eˣ) = x pour tout x. Donc ln(e²) = 2."
      },
      {
        "index": 4,
        "question_id": 5,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "(ln x)' = 1/x > 0 pour x > 0 : ln est bien strictement croissante."
      },
      {
        "index": 5,
        "question_id": 6,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "VRAI. ln strictement croissante : ln(x) < 2 = ln(e²) ⟺ 0 < x < e²."
      },
      {
        "index": 6,
        "question_id": 7,
        "type": "qcm",
        "answer": "−1",
        "correction": "ln(1/e) = ln(e⁻¹) = −1."
      },
      {
        "index": 7,
        "question_id": 8,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "lim(x→0⁺) ln(x) = −∞ : la courbe de ln s'approche verticalement de l'axe des y."
      }
    ]
  }
