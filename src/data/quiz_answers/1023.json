  "quiz": {
    "title": "Fonction exponentielle — définition & propriétés",
    "question_count": 8,
    "level": "Terminale",
    "subject": "Mathématiques",
    "answers": [
      {
        "index": 0,
        "question_id": 1,
        "type": "qcm",
        "answer": "B",
        "correction": "e⁰ = 1. Propriété fondamentale : toute base à la puissance 0 vaut 1."
      },
      {
        "index": 1,
        "question_id": 2,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "Propriété de l'exponentielle : e^(a+b) = eᵃ · eᵇ."
      },
      {
        "index": 2,
        "question_id": 3,
        "type": "open",
        "answer": "x = 3",
        "correction": "eˣ est injective : e^(2x) = e^(x+3) ⟺ 2x = x+3 ⟺ x = 3."
      },
      {
        "index": 3,
        "question_id": 4,
        "type": "qcm",
        "answer": "A",
        "correction": "e^(ln x) = x pour tout x > 0. Donc e^(ln 5) = 5."
      },
      {
        "index": 4,
        "question_id": 5,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "eˣ > 0 pour tout x ∈ R. La courbe de l'exponentielle est entièrement au-dessus de l'axe x."
      },
      {
        "index": 5,
        "question_id": 6,
        "type": "open",
        "answer": "x = 1 ou x = −1",
        "correction": "e^(x²−1) = 1 = e⁰ ⟺ x²−1 = 0 ⟺ x = ±1."
      },
      {
        "index": 6,
        "question_id": 7,
        "type": "qcm",
        "answer": "C",
        "correction": "e^(−ln 3) = 1/e^(ln 3) = 1/3."
      },
      {
        "index": 7,
        "question_id": 8,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "C'est une caractérisation de l'exponentielle. Si f' = f et f(0) = 1, alors f = exp."
      }
    ]
  }
