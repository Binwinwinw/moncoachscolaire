    "question_count": 8,
    "level": "Terminale",
    "subject": "Mathématiques",
    "answers": [
      {
        "index": 0,
        "question_id": 1,
        "type": "qcm",
        "answer": "B",
        "correction": "F est une primitive de f si F'(x) = f(x) pour tout x de I."
      },
      {
        "index": 1,
        "question_id": 2,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "(F+C)' = F' = f. Toutes les primitives diffèrent d'une constante."
      },
      {
        "index": 2,
        "question_id": 3,
        "type": "open",
        "answer": "F(x) = x³ − x² + x",
        "correction": "Primitive générale : x³ − x² + x + C. F(0) = C = 0 → F(x) = x³ − x² + x."
      },
      {
        "index": 3,
        "question_id": 4,
        "type": "qcm",
        "answer": "B",
        "correction": "∫₀¹ 2x dx = [x²]₀¹ = 1² − 0² = 1."
      },
      {
        "index": 4,
        "question_id": 5,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "[F(x)]ₐᵃ = F(a) − F(a) = 0 : une intégrale sur un intervalle de longueur nulle est toujours 0."
      },
      {
        "index": 5,
        "question_id": 6,
        "type": "open",
        "answer": "1",
        "correction": "∫₁ᵉ (1/x) dx = [ln x]₁ᵉ = ln(e) − ln(1) = 1 − 0 = 1."
      },
      {
        "index": 6,
        "question_id": 7,
        "type": "qcm",
        "answer": "A",
        "correction": "La primitive de eˣ est eˣ + C, car (eˣ)' = eˣ."
      },
      {
        "index": 7,
        "question_id": 8,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "Inverser les bornes change le signe de l'intégrale : F(b)−F(a) = −(F(a)−F(b))."
      }
    ]
