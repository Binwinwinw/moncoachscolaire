        "type": "qcm",
        "answer": "",
        "correction": "7π/3 − 2π = 7π/3 − 6π/3 = π/3. La mesure principale est π/3."
      },
      {
        "index": 4,
        "question_id": 5,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "α et α + 2kπ (k entier) représentent le même point sur le cercle trigonométrique."
      },
      {
        "index": 5,
        "question_id": 6,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "VRAI. π/6 rad = 30°. Sur le cercle unité : abscisse = cos(30°) = √3/2, ordonnée = sin(30°) = 1/2."
      },
      {
        "index": 6,
        "question_id": 7,
        "type": "qcm",
        "answer": "",
        "correction": "45° × π/180 = π/4."
