        "type": "qcm",
        "answer": "",
        "correction": "L'orthogonalité est caractérisée par un produit scalaire nul : u⃗·v⃗ = 0."
      },
      {
        "index": 1,
        "question_id": 2,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "Identité remarquable : ||u+v||² = (u+v)·(u+v) = ||u||² + 2u·v + ||v||²."
      },
      {
        "index": 2,
        "question_id": 3,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "VRAI. Produit scalaire AB⃗·AC⃗ = 3×0 + 0×3 = 0 → orthogonaux → angle droit en A."
      },
      {
        "index": 3,
        "question_id": 4,
        "type": "qcm",
        "answer": "",
        "correction": "||u−v||² = (u−v)·(u−v) = ||u||² − 2u·v + ||v||²."
      },
      {
        "index": 4,
        "question_id": 5,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "La médiatrice est définie par MA = MB (équidistance), pas par MA⃗·MB⃗=0."
      },
      {
        "index": 5,
        "question_id": 6,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "VRAI. u⃗·v⃗=1, ||u⃗||=1, ||v⃗||=√2. cos θ=1/√2 → θ=π/4."
      },
      {
        "index": 6,
        "question_id": 7,
        "type": "qcm",
        "answer": "",
        "correction": "||u+v||² = ||u||²+2u·v+||v||² et ||u−v||² = ||u||²−2u·v+||v||². Soustraction : 4u·v → u·v = (||u+v||²−||u−v||²)/4."
      },
      {
        "index": 7,
        "question_id": 8,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "u⃗·v⃗ = ||u⃗||·||v⃗||·cos θ. Si égalité, alors cos θ = 1 → θ = 0 → colinéaires de même sens."
      }
    ]
