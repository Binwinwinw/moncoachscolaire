        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "3x − 5 > 7 → 3x > 12 → x > 4, donc x ∈ ]4 ; +∞[."
      },
      {
        "index": 3,
        "question_id": 4,
        "type": "qcm",
        "answer": "C",
        "correction": "−1 inclus (crochet fermé) et 5 exclu (crochet ouvert) donne [−1 ; 5[."
      },
      {
        "index": 4,
        "question_id": 5,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "L'ordre sur R est transitif : a < b et b < c implique a < c."
      },
      {
        "index": 5,
        "question_id": 6,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "2x+1>5 → x>2 ; x−3<2 → x<5. L'intersection est ]2 ; 5[."
      },
