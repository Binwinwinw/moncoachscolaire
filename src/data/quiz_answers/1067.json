        "type": "qcm",
        "answer": "",
        "correction": "Terme général d'une suite géométrique (indexée à partir de 1) : uₙ = u₁ · q^(n−1)."
      },
      {
        "index": 1,
        "question_id": 2,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "Rapport constant : 6/3=2, 12/6=2, 24/12=2. Raison q = 2."
      },
      {
        "index": 2,
        "question_id": 3,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "VRAI. u₄ = 5×3³ = 135. Sₙ = u₁(qⁿ−1)/(q−1) = 5×(81−1)/2 = 200."
      },
      {
        "index": 3,
        "question_id": 4,
        "type": "qcm",
        "answer": "",
        "correction": "Sₙ = u₁·(qⁿ − 1)/(q − 1). Équivalent à u₁·(1 − qⁿ)/(1 − q)."
      },
      {
        "index": 4,
        "question_id": 5,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "Pour |q| < 1 : qⁿ → 0 quand n → +∞, donc uₙ → 0."
      },
      {
        "index": 5,
        "question_id": 6,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "VRAI. Suite géométrique de raison q=1,03. C₁₀ = 2000×1,03¹⁰ ≈ 2687,83."
      },
      {
        "index": 6,
        "question_id": 7,
        "type": "qcm",
        "answer": "",
        "correction": "q > 1 et u₁ > 0 : uₙ₊₁ = uₙ·q > uₙ → suite strictement croissante."
      },
      {
        "index": 7,
        "question_id": 8,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "uₙ² = uₙ₋₁ · uₙ₊₁ : propriété caractéristique des suites géométriques."
      }
    ]
  }
