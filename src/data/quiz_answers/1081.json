    "answers": [
      {
        "index": 0,
        "question_id": 1,
        "type": "qcm",
        "answer": "",
        "correction": "cos(x + 2π) = cos(x) : la période est 2π."
      },
      {
        "index": 1,
        "question_id": 2,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "sin est impaire (symétrie centrale par rapport à l'origine sur la courbe)."
      },
      {
        "index": 2,
        "question_id": 3,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "VRAI. Sur [0,π] : cos décroît de 1 à −1. Sur [π,2π] : cos croît de −1 à 1."
      },
      {
        "index": 3,
        "question_id": 4,
        "type": "qcm",
        "answer": "",
        "correction": "Le sinus est borné : −1 ≤ sin(x) ≤ 1 pour tout réel x."
      },
      {
        "index": 4,
        "question_id": 5,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "cos(x − π/2) = sin(x) : la courbe de sin est celle de cos décalée de π/2 à droite."
      },
      {
        "index": 5,
        "question_id": 6,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "VRAI. Multiplier par 2 double les ordonnées : même période, amplitude doublée."
      },
      {
        "index": 6,
        "question_id": 7,
        "type": "qcm",
        "answer": "",
        "correction": "sin(3x) a une période T = 2π/3 (le coefficient 3 divise la période par 3)."
      },
      {
        "index": 7,
        "question_id": 8,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "(sin x)' = cos x. De même (cos x)' = −sin x."
      }
    ]
  }
