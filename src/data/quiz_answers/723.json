    "title": "Électricité : puissance et énergie électrique",
    "question_count": 8,
    "level": "3ème",
    "subject": "Physique-Chimie",
    "answers": [
      {
        "index": 0,
        "question_id": 1,
        "type": "qcm",
        "answer": "P = U × I",
        "correct": 2,
        "correction": "La puissance P = U × I (en watts) mesure la vitesse de transfert d'énergie électrique."
      },
      {
        "index": 1,
        "question_id": 2,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "E = P × t = 2 000 W × 1 h = 2 000 Wh = 2 kWh."
      },
      {
        "index": 2,
        "question_id": 3,
        "type": "open",
        "answer": "kilowattheure",
        "correction": "Le kilowattheure (kWh) est l'énergie consommée par un appareil de 1 kW pendant 1 heure. 1 kWh = 3,6 × 10^6 J."
      },
      {
        "index": 3,
        "question_id": 4,
        "type": "qcm",
        "answer": "25 W",
        "correct": 1,
        "correction": "P = R × I² = 100 × 0,5² = 100 × 0,25 = 25 W."
      },
      {
        "index": 4,
        "question_id": 5,
        "type": "vrai-faux",
        "answer": "vrai",
        "correction": "L'effet Joule : Q = R × I² × t. C'est le principe du chauffage électrique, du grille-pain et des fusibles."
      },
      {
        "index": 5,
        "question_id": 6,
        "type": "open",
        "answer": "disjoncteur",
        "correction": "Le disjoncteur (ou fusible) protège les circuits et les appareils d'une surintensité pouvant causer un incendie."
      },
