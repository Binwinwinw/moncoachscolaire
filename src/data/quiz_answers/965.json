        "type": "qcm",
        "answer": "a⁸",
        "correction": "aᵐ × aⁿ = aᵐ⁺ⁿ. Donc a⁵ × a³ = a⁵⁺³ = a⁸."
      },
      {
        "index": 4,
        "question_id": 5,
        "type": "vrai-faux",
        "answer": "faux",
        "correction": "√(a²) = |a|, la valeur absolue de a. Si a < 0, alors √(a²) = −a ≠ a."
      },
