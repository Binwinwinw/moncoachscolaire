      {
        "type": "qcm",
        "question": "Le produit scalaire u⃗·v⃗ en coordonnées est :",
        "choices": [
          "u₁v₂ − u₂v₁",
          "u₁v₁ + u₂v₂",
          "(u₁+v₁)(u₂+v₂)",
          "u₁v₂ + u₂v₁"
        ]
      },
      {
        "type": "vrai-faux",
        "question": "Le produit scalaire de deux vecteurs est un scalaire (nombre réel), pas un vecteur."
      },
      {
        "type": "vrai-faux",
        "question": "U⃗·v⃗ = 3×1 + (−2)×4 = 3 − 8 = −5."
      },
      {
        "type": "qcm",
        "question": "La formule avec l'angle θ entre u⃗ et v⃗ donne u⃗·v⃗ = :",
        "choices": [
          "||u⃗|| + ||v⃗||·cos θ",
          "||u⃗||·||v⃗||·cos θ",
          "||u⃗||·||v⃗||·sin θ",
          "||u⃗ − v⃗||·cos θ"
        ]
      },
      {
        "type": "vrai-faux",
        "question": "u⃗·u⃗ = ||u⃗||²."
      },
      {
        "type": "vrai-faux",
        "question": "AB⃗=(3,0), AC⃗=(0,4)."
      },
      {
        "type": "qcm",
        "question": "Que vaut u⃗·v⃗ si les vecteurs sont orthogonaux ?",
        "choices": [
          "||u⃗||·||v⃗||",
          "1",
          "0",
          "||u⃗|| + ||v⃗||"
        ]
      },
      {
        "type": "vrai-faux",
        "question": "Le produit scalaire est commutatif : u⃗·v⃗ = v⃗·u⃗."
      }
    ]
