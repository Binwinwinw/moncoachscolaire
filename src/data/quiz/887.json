      {
        "type": "qcm",
        "question": "La notation O(n) signifie que l'algorithme a une complexité :",
        "choices": [
          "Constante",
          "Linéaire",
          "Quadratique",
          "Logarithmique"
        ]
      },
      {
        "type": "vrai-faux",
        "question": "O(1) représente une complexité constante, indépendante de la taille des données."
      },
      {
        "type": "vrai-faux",
        "question": "O(1) < O(log n) < O(n) < O(n log n) < O(n²)."
      },
      {
        "type": "qcm",
        "question": "Quelle est la complexité temporelle d'un accès à un élément dans un tableau par son indice ?",
        "choices": [
          "O(n)",
          "O(log n)",
          "O(1)",
          "O(n²)"
        ]
      },
      {
        "type": "vrai-faux",
        "question": "La complexité en espace mesure la mémoire supplémentaire utilisée par un algorithme."
      },
      {
        "type": "vrai-faux",
        "question": "Big O capture le comportement asymptotique (croissance) pour de grands n, en ignorant les constantes multiplicatives et les termes de degré inférieur."
      },
      {
        "type": "qcm",
        "question": "Deux boucles for imbriquées, chacune itérant n fois, donnent une complexité de :",
        "choices": [
          "O(n)",
          "O(2n)",
          "O(n log n)",
          "O(n²)"
        ]
      },
      {
        "type": "vrai-faux",
        "question": "Un algorithme récursif peut avoir une complexité exponentielle."
      }
    ]
