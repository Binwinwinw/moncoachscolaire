    "questions": [
      {
        "type": "qcm",
        "question": "Le nombre dérivé de f en a est défini par :",
        "choices": [
          "f(a+h) − f(a)",
          "lim(h→0) [f(a+h) − f(a)] / h",
          "f(a) / h",
          "[f(a+1) − f(a)]"
        ]
      },
      {
        "type": "vrai-faux",
        "question": "La droite tangente à la courbe de f au point d'abscisse a a pour pente f'(a)."
      },
      {
        "type": "vrai-faux",
        "question": "[f(3+h)−f(3)]/h = [(3+h)²−9]/h = [9+6h+h²−9]/h = 6+h → 6 quand h→0."
      },
      {
        "type": "qcm",
        "question": "L'équation de la tangente à la courbe de f en a est :",
        "choices": [
          "y = f(a) + f(x)(x − a)",
          "y = f'(a)(x − a) + f(a)",
          "y = f(a) − f'(a)·x",
          "y = f'(a)·x"
        ]
      },
      {
        "type": "vrai-faux",
        "question": "Le taux de variation de f entre a et b est (f(b) − f(a))/(b − a)."
      },
      {
        "type": "vrai-faux",
        "question": "Cette affirmation reformule l'idée essentielle à retenir : Détermine l'équation de la tangente à f(x) = x² − 2x en x = 1."
      },
      {
        "type": "qcm",
        "question": "Si f'(a) = 0, la tangente à la courbe de f en a est :",
        "choices": [
          "Verticale",
          "Horizontale",
          "Oblique",
          "Indéfinie"
        ]
      },
      {
        "type": "vrai-faux",
        "question": "Le nombre dérivé mesure le taux de variation instantané de la fonction."
      }
    ]
  },
