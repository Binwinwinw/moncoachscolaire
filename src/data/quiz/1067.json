    "questions": [
      {
        "type": "qcm",
        "question": "Dans une suite géométrique de premier terme u₁ et de raison q, que vaut uₙ ?",
        "choices": [
          "uₙ = u₁ + (n−1)·q",
          "uₙ = u₁ · q^(n−1)",
          "uₙ = u₁ · qⁿ",
          "uₙ = q + u₁^(n−1)"
        ]
      },
      {
        "type": "vrai-faux",
        "question": "La suite 3, 6, 12, 24, … est géométrique de raison 2."
      },
      {
        "type": "vrai-faux",
        "question": "Dans une suite géométrique, chaque terme s'obtient en multipliant le précédent par une même raison."
      },
      {
        "type": "qcm",
        "question": "La somme des n premiers termes d'une suite géométrique (q ≠ 1) est :",
        "choices": [
          "n·u₁·q",
          "u₁·(qⁿ − 1)/(q − 1)",
          "u₁/(1 − q)",
          "u₁·(1 − qⁿ)/(q − 1)"
        ]
      },
      {
        "type": "vrai-faux",
        "question": "Si |q| < 1, la suite géométrique uₙ = u₁·qⁿ tend vers 0."
      },
      {
        "type": "vrai-faux",
        "question": "Suite géométrique de raison q=1,03."
      },
      {
        "type": "qcm",
        "question": "Dans une suite géométrique de raison q > 1, la suite est :",
        "choices": [
          "Constante",
          "Décroissante",
          "Croissante (si u₁ > 0)",
          "Alternée"
        ]
      },
      {
        "type": "vrai-faux",
        "question": "Chaque terme d'une suite géométrique est la moyenne géométrique de ses deux voisins."
      }
    ]
  },
