    "questions": [
      {
        "type": "qcm",
        "question": "Le raisonnement par récurrence comporte deux étapes essentielles :",
        "choices": [
          "Calcul du premier terme et du dernier terme",
          "Initialisation (vérifier pour n=n₀) et hérédité (si vrai pour n, vrai pour n+1)",
          "Calcul du discriminant et des racines",
          "Démonstration directe et par l'absurde"
        ]
      },
      {
        "type": "vrai-faux",
        "question": "Si l'hérédité est vérifiée mais pas l'initialisation, la propriété n'est pas démontrée."
      },
      {
        "type": "vrai-faux",
        "question": "Init : n=1 : 1 = 1×2/2 = 1."
      },
      {
        "type": "qcm",
        "question": "Quelle est la propriété P(n) si on veut montrer que 2ⁿ > n pour tout n ≥ 1 ?",
        "choices": [
          "P(n) : 2ⁿ = n",
          "P(n) : 2ⁿ > n",
          "P(n) : 2ⁿ < n",
          "P(n) : 2ⁿ − n = 0"
        ]
      },
      {
        "type": "vrai-faux",
        "question": "Pour l'étape d'hérédité, on suppose P(n) vraie (hypothèse de récurrence) et on démontre P(n+1)."
      },
      {
        "type": "vrai-faux",
        "question": "Pour n=1 : 3¹ = 3 ≥ 2×1+1 = 3."
      },
      {
        "type": "qcm",
        "question": "Quelle est la somme 1 + 3 + 5 + … + (2n−1) (n termes impairs consécutifs) ?",
        "choices": [
          "n²",
          "n(n+1)/2",
          "2n−1",
          "n(2n−1)"
        ]
      },
      {
        "type": "vrai-faux",
        "question": "Le principe de récurrence est valable pour les propriétés concernant des entiers naturels."
      }
    ]
  },
