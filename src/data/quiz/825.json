    "questions": [
      {
        "type": "qcm",
        "question": "Quel est l'objectif principal d'une entreprise privée selon la théorie néoclassique ?",
        "choices": [
          "Maximiser le bien-être social",
          "Maximiser le profit",
          "Minimiser les effectifs",
          "Maximiser les salaires"
        ]
      },
      {
        "type": "vrai-faux",
        "question": "Toutes les entreprises ont uniquement un objectif de profit."
      },
      {
        "type": "open",
        "question": "Qu'est-ce que la responsabilité sociale des entreprises (RSE) ?"
      },
      {
        "type": "qcm",
        "question": "Qui sont les 'parties prenantes' (stakeholders) d'une entreprise ?",
        "choices": [
          "Uniquement les actionnaires",
          "Tous les acteurs affectés par l'activité de l'entreprise",
          "Seulement les salariés",
          "Les concurrents uniquement"
        ]
      },
      {
        "type": "vrai-faux",
        "question": "Le conflit entre actionnaires et dirigeants est appelé 'problème principal-agent'."
      },
      {
        "type": "open",
        "question": "Distinguez valeur ajoutée et profit."
      },
      {
        "type": "qcm",
        "question": "La valeur ajoutée se calcule comme :",
        "choices": [
          "Chiffre d'affaires - salaires",
          "Chiffre d'affaires - consommations intermédiaires",
          "Profit + impôts",
          "Recettes - dépenses"
        ]
      },
      {
        "type": "vrai-faux",
        "question": "La somme des valeurs ajoutées d'une économie constitue le PIB."
      }
    ]
