    "questions": [
      {
        "type": "qcm",
        "question": "Quel événement marque le début de la grossesse au sens biologique ?",
        "choices": [
          "La puberté",
          "La fécondation",
          "La menstruation",
          "La ménopause"
        ]
      },
      {
        "type": "vrai-faux",
        "question": "Le préservatif est à la fois un moyen de contraception et une protection contre de nombreuses IST."
      },
      {
        "type": "vrai-faux",
        "question": "L'ovulation survient en général au milieu du cycle et rend possible la fécondation pendant une courte période."
      },
      {
        "type": "qcm",
        "question": "Quel organe assure les échanges nutritifs et gazeux entre la mère et le fœtus ?",
        "choices": [
          "Le foie",
          "Le placenta",
          "Le rein",
          "Le pancréas"
        ]
      },
      {
        "type": "vrai-faux",
        "question": "L'alcool consommé pendant la grossesse peut traverser le placenta."
      },
      {
        "type": "vrai-faux",
        "question": "L'IVG peut être médicamenteuse ou chirurgicale selon le terme de la grossesse et le cadre légal."
      },
      {
        "type": "qcm",
        "question": "À la puberté, l'apparition des caractères sexuels secondaires est déclenchée par :",
        "choices": [
          "Les hormones sexuelles",
          "Les anticorps",
          "Les vitamines",
          "Les enzymes digestives"
        ]
      },
      {
        "type": "vrai-faux",
        "question": "La PMA peut inclure une fécondation in vitro réalisée en laboratoire."
      }
    ]
