          "π",
          "2",
          "1",
          "360"
        ]
      },
      {
        "type": "vrai-faux",
        "question": "Un angle de π radians correspond à 180°."
      },
      {
        "type": "vrai-faux",
        "question": "270° × π/180 = 3π/2."
      },
