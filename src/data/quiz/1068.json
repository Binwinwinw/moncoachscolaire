    "questions": [
      {
        "type": "qcm",
        "question": "Pour étudier la monotonie d'une suite, on peut :",
        "choices": [
          "Calculer seulement u₁",
          "Étudier le signe de uₙ₊₁ − uₙ ou le rapport uₙ₊₁/uₙ",
          "Tracer la courbe de la suite",
          "Calculer la moyenne"
        ]
      },
      {
        "type": "vrai-faux",
        "question": "Si uₙ₊₁ − uₙ > 0 pour tout n, la suite est strictement croissante."
      },
      {
        "type": "vrai-faux",
        "question": "Uₙ₊₁ − uₙ = 2n − 2 > 0 pour n ≥ 2 → suite croissante pour n ≥ 2."
      },
      {
        "type": "qcm",
        "question": "La suite uₙ = (n+1)/n est :",
        "choices": [
          "Croissante",
          "Décroissante",
          "Constante",
          "Non monotone"
        ]
      },
      {
        "type": "vrai-faux",
        "question": "Une suite bornée et monotone est convergente."
      },
      {
        "type": "vrai-faux",
        "question": "Uₙ₊₁ − uₙ = (3 − 1/(n+1)) − (3 − 1/n) = 1/n − 1/(n+1) = 1/(n(n+1)) > 0 → croissante."
      },
      {
        "type": "qcm",
        "question": "La suite géométrique uₙ = 2×(0,5)ⁿ est :",
        "choices": [
          "Croissante",
          "Décroissante",
          "Constante",
          "Alternée"
        ]
      },
      {
        "type": "vrai-faux",
        "question": "La suite uₙ = (−1)ⁿ/n est bornée."
      }
    ]
  },
