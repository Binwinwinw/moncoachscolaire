    "questions": [
      {
        "type": "qcm",
        "question": "Sur le cercle trigonométrique, cos(θ) et sin(θ) sont respectivement :",
        "choices": [
          "L'ordonnée et l'abscisse du point M(θ)",
          "L'abscisse et l'ordonnée du point M(θ)",
          "La tangente et la cotangente",
          "Le rayon et l'arc"
        ]
      },
      {
        "type": "vrai-faux",
        "question": "cos²(θ) + sin²(θ) = 1 pour tout réel θ."
      },
      {
        "type": "vrai-faux",
        "question": "1, √3/2, √2/2, 1/2, 0."
      },
      {
        "type": "qcm",
        "question": "Que vaut sin(π/3) ?",
        "choices": [
          "1/2",
          "√2/2",
          "√3/2",
          "1"
        ]
      },
      {
        "type": "vrai-faux",
        "question": "cos(−θ) = cos(θ) (le cosinus est une fonction paire)."
      },
      {
        "type": "vrai-faux",
        "question": "Sin(π/6) = 1/2 → sin²(π/6) = 1/4."
      },
      {
        "type": "qcm",
        "question": "Que vaut cos(π) ?",
        "choices": [
          "0",
          "1",
          "−1",
          "√2/2"
        ]
      },
      {
        "type": "vrai-faux",
        "question": "sin(θ + 2π) = sin(θ) pour tout réel θ."
      }
