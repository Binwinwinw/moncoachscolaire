{
  "name": "moncoachscolaire/moncoachscolaire",
  "description": "MonCoachScolaire - gamified education platform",
  "require": {
    "vlucas/phpdotenv": "^5.5",
    "erusev/parsedown": "^1.7",
    "smalot/pdfparser": "^2.12",
    "phpmailer/phpmailer": "^6.9",
    "opis/json-schema": "^2.6"
  },
  "scripts": {
    "post-install-cmd": [
      "php scripts/composer-post-install.php"
    ]
  },
  "require-dev": {
    "phpunit/phpunit": "^12.5",
    "friendsofphp/php-cs-fixer": "^3.94"
  }
  ,
  "autoload": {
    "psr-4": {
      "MonCoachScolaire\\Parsers\\": "dev/tools/exercises/Parsers/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MonCoachScolaire\\Tests\\Parsers\\": "dev/tools/exercises/Parsers/Tests/"
    }
  }
}
